{
  "name": "AdoMaster",
  "version": "1.2.4",
  "description": "Azure DevOps Iteration / Work Item 檢視工具",
  "author": "ART Solutions",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "anser": "^2.3.5",
    "marked": "^18.1.3",
    "python-shell": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.artsolutions.adomaster",
    "productName": "AdoMaster",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../script",
        "to": "script",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../shell",
        "to": "shell",
        "filter": [
          "*.ps1"
        ]
      },
      {
        "from": "../docs",
        "to": "docs",
        "filter": [
          "user-guide.md"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../feature/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AdoMaster",
      "artifactName": "AdoMaster-Setup-${version}.${ext}"
    }
  }
}
