# UpAgent 發佈（shell/Release-UpAgent.ps1）用的設定檔（INI 格式）
#
# 複製到 data/upagent_release.config 後填入（data/ 不進 git；可用「檔案 → 匯出 / 匯入本地資料」帶到其他電腦）。
# 本檔含有存取憑證，請勿提交到版控或外流。
#
# 何時執行：Requirement 的規劃選了 upagent，且在「測試環境佈版 / 正式環境佈版」勾起 SaaS 或 Local 時。
#   - 第一次：完整發佈（更版 → 等 GitHub Action → 下載 → 簽署 → 重算 latest.yml → 上傳 Blob → 清 staging）
#     再寫入該環境的資料庫
#   - 之後（已上傳過 Blob）：只寫入該環境的資料庫
# upagent 的本機路徑取自 data/repos.json 中 key 為 upagent 的 path。

[upagent_release]
storage_account = updayservice
container = upagent
staging_folder = staging
release_folder = releases
# 更版、push tag 的 branch 是規劃中 upagent 的 feature branch（不在這裡設定）；
# 下載 / 簽署的檔案放在 data\upagent_release\<版號>\

[github]
# 步驟 2 輪詢 Release workflow 用
owner = artsolutionsdev
repo = upagent
workflow_file = release.yml
# Personal Access Token（需能讀取 upagent repo 的 Actions）
# 也可改用環境變數 GITHUB_TOKEN，環境變數優先度高於本檔。
token =

[codesign]
signtool = C:\Program Files (x86)\Windows Kits\8.1\bin\x86\signtool.exe
cert_subject = ART Solutions Limited
timestamp_url = http://timestamp.globalsign.com/tsa/r6advanced1

[upagent_db_test]
# 測試環境佈版時寫入 public.public_db_upagentrelease 的資料庫
# psql 不在 PATH 時填完整路徑，例如 C:\Program Files\PostgreSQL\16\bin\psql.exe
psql =
host =
port = 5432
dbname =
user =
password =
sslmode = require

[upagent_db_prod]
# 正式環境佈版時寫入 public.public_db_upagentrelease 的資料庫
psql =
host =
port = 5432
dbname =
user =
password =
sslmode = require
